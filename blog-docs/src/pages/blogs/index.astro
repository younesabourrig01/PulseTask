---
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import BlogsLayout from "../../layouts/BlogsLayout.astro";

const blogs = await getCollection("blogs");
const sortedBlogs = blogs.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BlogsLayout
  title="PulseTask Blog"
  description="PulseTask release notes, architecture updates, and engineering notes."
>
  <main>
    <header class="feed-header">
      <p class="eyebrow">Product & engineering</p>
      <h1>PulseTask Blog</h1>
      <p>Catch up on architectural updates, release notes, and dev logs.</p>
    </header>
    <section class="feed-container" aria-label="Latest posts">
      {
        sortedBlogs.map((blog) => (
          <BlogCard
            title={blog.data.title}
            pubDate={blog.data.pubDate}
            author={blog.data.author}
            tags={blog.data.tags}
            id={blog.id}
          />
        ))
      }
    </section>
  </main>
</BlogsLayout>

<style>
  main {
    width: min(calc(100% - 2rem), var(--content-width));
    margin-inline: auto;
  }
  .feed-header {
    max-width: 45rem;
    padding: 4rem 0 2.5rem;
  }
  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    letter-spacing: -0.065em;
    line-height: 1;
  }
  .feed-header > p:last-child {
    max-width: 38rem;
    margin: 1.25rem 0 0;
    color: var(--color-muted);
    font-size: 1.125rem;
  }
  .feed-container {
    display: grid;
    gap: 1rem;
  }
</style>
