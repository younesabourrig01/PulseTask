---
import { getCollection, render } from "astro:content";
import BlogsLayout from "../../layouts/BlogsLayout.astro";

export async function getStaticPaths() {
  const blogs = await getCollection("blogs");
  return blogs.map((blog) => ({ params: { slug: blog.id }, props: { blog } }));
}

const { blog } = Astro.props;
const { Content } = await render(blog);
---

<BlogsLayout title={`${blog.data.title} | PulseTask Blog`}>
  <main>
    <a class="back-link" href="/blogs">← All posts</a>
    <article>
      <header>
        <div class="tags">{blog.data.tags.map((tag) => <span>#{tag}</span>)}</div>
        <h1>{blog.data.title}</h1>
        <p class="meta">By {blog.data.author} · <time datetime={blog.data.pubDate.toISOString()}>{blog.data.pubDate.toLocaleDateString("en", { dateStyle: "long" })}</time></p>
      </header>
      <div class="prose"><Content /></div>
    </article>
  </main>
</BlogsLayout>

<style>
  main { width: min(calc(100% - 2rem), 46rem); margin: 0 auto; padding: 3rem 0; }
  .back-link { color: var(--color-accent); font-weight: 700; text-decoration: none; }
  article { margin-top: 2.5rem; }
  h1 { margin: 0.75rem 0 1rem; font-size: clamp(2.25rem, 6vw, 4rem); letter-spacing: -0.06em; line-height: 1.05; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; color: var(--color-accent); font-size: 0.85rem; font-weight: 800; }
  .meta { color: var(--color-muted); }
  .prose { margin-top: 3rem; font-size: 1.08rem; }
  .prose :global(h2), .prose :global(h3) { margin-top: 2.25em; line-height: 1.2; }
  .prose :global(a) { color: var(--color-accent); }
  .prose :global(code) { padding: 0.1em 0.3em; background: #ecebff; border-radius: 0.25rem; }
</style>
