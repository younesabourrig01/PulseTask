---
import { getCollection } from "astro:content";

const docs = await getCollection("docs");
---

<html lang="en">
  <head>
    <title>Documentation</title>
  </head>
  <body>
    <h1>All Documentation</h1>
    <ul>
      {
        docs.map((doc) => (
          <li>
            <a href={`/docs/${doc.id}`}>{doc.data.title}</a>
          </li>
        ))
      }
    </ul>
  </body>
</html>
